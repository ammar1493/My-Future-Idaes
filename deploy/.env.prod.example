# Copy to .env.prod and fill in. Used by docker-compose.prod.yml.

# Your domains (create DNS A records -> this server's public IP)
APP_DOMAIN=app.example.com
LIVEKIT_DOMAIN=lk.example.com

# Database
POSTGRES_USER=livetrain
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=livetrain

# App secret (generate: openssl rand -hex 32)
SECRET_KEY=change-me-long-random-secret

# LiveKit credentials — MUST match deploy/livekit.yaml `keys:` and `webhook.api_key`
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-this-to-a-long-random-secret
