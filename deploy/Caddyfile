# Automatic HTTPS (Let's Encrypt) for your own domains.

# The platform — frontend at /, API + websockets proxied to the backend so
# everything is same-origin (no CORS, no separate API host).
{$APP_DOMAIN} {
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /ws/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:80
	}
}

# Self-hosted LiveKit signaling (wss). Media (UDP/TCP) goes directly to the
# livekit container's published ports, not through Caddy.
{$LIVEKIT_DOMAIN} {
	reverse_proxy livekit:7880
}
