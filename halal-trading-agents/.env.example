# Create the key at Binance > API Management.
# Enable ONLY "Enable Reading" + "Enable Spot & Margin Trading" (spot is all we use).
# NEVER enable withdrawals, margin, or futures. Restrict the key to your IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=
