# Copy to .env and adjust for your environment.
APP_NAME=LiveTrain
ENVIRONMENT=development
SECRET_KEY=please-generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
DATABASE_URL=postgresql+psycopg://livetrain:livetrain@localhost:5432/livetrain
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Attendance policy (global defaults; per-course overrides win)
ATTENDANCE_PRESENT_THRESHOLD=0.75
ATTENDANCE_PARTIAL_THRESHOLD=0.25
PRESENCE_HEARTBEAT_SECONDS=30

# LiveKit (leave blank to use the built-in WebRTC mesh fallback).
# Get these from LiveKit Cloud (https://cloud.livekit.io) or your self-hosted server.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# In the LiveKit project settings, add a webhook pointing to:
#   https://<your-backend-host>/api/livekit/webhook
