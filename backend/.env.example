# Copy to .env (local) or set as Environment Variables in the Vercel backend project.
APP_NAME=NEFT Energies
ENVIRONMENT=production
SECRET_KEY=please-generate-a-long-random-secret   # openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Vercel Postgres connection string, rewritten with the +psycopg driver.
# Example: postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/neftenergies

# Comma-separated allowed origins = your frontend Vercel URL(s).
CORS_ORIGINS=http://localhost:5173

# First login: a coordinator is auto-created on startup from these (if not present).
BOOTSTRAP_COORDINATOR_EMAIL=admin@neftenergies.com
BOOTSTRAP_COORDINATOR_PASSWORD=change-me-strong-password
BOOTSTRAP_COORDINATOR_NAME=NEFT Coordinator

# Attendance policy (global defaults; per-course overrides win)
ATTENDANCE_PRESENT_THRESHOLD=0.75
ATTENDANCE_PARTIAL_THRESHOLD=0.25
PRESENCE_HEARTBEAT_SECONDS=30

# LiveKit Cloud (https://cloud.livekit.io) — carries the audio/video.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# In the LiveKit project settings, add a webhook pointing to:
#   https://<your-backend>.vercel.app/api/livekit/webhook
